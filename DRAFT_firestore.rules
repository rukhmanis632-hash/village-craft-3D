rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity Validation Blueprints
    function isValidPlayerProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.coins is int && data.coins >= 0 && data.coins <= 100000000 &&
             data.rubies is int && data.rubies >= 0 && data.rubies <= 1000000 &&
             data.selectedWorld is int && data.selectedWorld >= 0 && data.selectedWorld <= 3 &&
             data.selectedChar is string && data.selectedChar.size() >= 1 && data.selectedChar.size() <= 32 &&
             data.selectedBoard is string && data.selectedBoard.size() >= 1 && data.selectedBoard.size() <= 32 &&
             data.challengeDist is int && data.challengeDist >= 0 && data.challengeDist <= 2000 &&
             data.challengeGems is int && data.challengeGems >= 0 && data.challengeGems <= 5 &&
             data.magnetLevel is int && data.magnetLevel >= 1 && data.magnetLevel <= 50 &&
             data.shieldLevel is int && data.shieldLevel >= 1 && data.shieldLevel <= 50 &&
             data.boostLevel is int && data.boostLevel >= 1 && data.boostLevel <= 50 &&
             data.multiplierLevel is int && data.multiplierLevel >= 1 && data.multiplierLevel <= 50 &&
             data.highScoreW0 is int && data.highScoreW0 >= 0 && data.highScoreW0 <= 100000000 &&
             data.highScoreW1 is int && data.highScoreW1 >= 0 && data.highScoreW1 <= 100000000 &&
             data.highScoreW2 is int && data.highScoreW2 >= 0 && data.highScoreW2 <= 100000000 &&
             data.highScoreW3 is int && data.highScoreW3 >= 0 && data.highScoreW3 <= 100000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRunRecord(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.runnerName is string && data.runnerName.size() >= 1 && data.runnerName.size() <= 50 &&
             data.worldId is int && data.worldId >= 0 && data.worldId <= 3 &&
             data.characterId is string && data.characterId.size() >= 1 && data.characterId.size() <= 32 &&
             data.score is int && data.score >= 0 && data.score <= 100000000 &&
             data.distanceMeters is int && data.distanceMeters >= 0 && data.distanceMeters <= 1000000 &&
             data.coinsCollected is int && data.coinsCollected >= 0 && data.coinsCollected <= 1000000 &&
             data.rubiesCollected is int && data.rubiesCollected >= 0 && data.rubiesCollected <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'coins', 'rubies',
                         'selectedWorld', 'selectedChar', 'selectedBoard',
                         'challengeDist', 'challengeGems',
                         'magnetLevel', 'shieldLevel', 'boostLevel', 'multiplierLevel',
                         'highScoreW0', 'highScoreW1', 'highScoreW2', 'highScoreW3',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'coins', 'rubies',
                         'selectedWorld', 'selectedChar', 'selectedBoard',
                         'challengeDist', 'challengeGems',
                         'magnetLevel', 'shieldLevel', 'boostLevel', 'multiplierLevel',
                         'highScoreW0', 'highScoreW1', 'highScoreW2', 'highScoreW3',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidPlayerProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPlayerProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'coins', 'rubies',
                         'selectedWorld', 'selectedChar', 'selectedBoard',
                         'challengeDist', 'challengeGems',
                         'magnetLevel', 'shieldLevel', 'boostLevel', 'multiplierLevel',
                         'highScoreW0', 'highScoreW1', 'highScoreW2', 'highScoreW3',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 5. Collection Rules: /run_records/{recordId}
    match /run_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(recordId) &&
                       incoming().keys().hasAll([
                         'userId', 'runnerName', 'worldId', 'characterId',
                         'score', 'distanceMeters', 'coinsCollected', 'rubiesCollected',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'runnerName', 'worldId', 'characterId',
                         'score', 'distanceMeters', 'coinsCollected', 'rubiesCollected',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidRunRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(recordId) &&
                       existing().userId == request.auth.uid &&
                       isValidRunRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'runnerName', 'score', 'distanceMeters', 'coinsCollected', 'rubiesCollected', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(recordId) && existing().userId == request.auth.uid;
    }
  }
}
